{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xaroth/pbt-engine/simulator/wire.schema.json",
  "title": "Wire",
  "description": "The JSON of simulator results, as a host sends them to a UI. Every field is always present unless marked optional, and lists keep the engine's order.",
  "anyOf": [
    { "$ref": "#/$defs/Stats" },
    { "$ref": "#/$defs/Diff" },
    { "$ref": "#/$defs/Result" },
    { "$ref": "#/$defs/Output" },
    { "$ref": "#/$defs/Explanation" }
  ],
  "$defs": {
    "Output": {
      "title": "Output",
      "description": "A catalogue entry: an output's key and how to show its value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "unit", "places", "group", "better", "order"],
      "properties": {
        "key": { "type": "string", "description": "The output key, such as \"player.life\"." },
        "label": { "type": "string" },
        "unit": { "$ref": "#/$defs/Unit" },
        "places": { "type": "integer", "minimum": 0, "description": "Decimal places to show." },
        "group": { "$ref": "#/$defs/OutputGroup" },
        "better": { "$ref": "#/$defs/Better" },
        "order": { "type": "integer", "minimum": 0, "description": "Position in the catalogue; lower shows first." }
      }
    },
    "Unit": {
      "title": "Unit",
      "description": "An output's unit: none, percent or per second.",
      "enum": ["", "%", "/s"]
    },
    "OutputGroup": {
      "title": "OutputGroup",
      "description": "The panel an output is shown in: the character sheet, defences, or the main skill (read in its context).",
      "enum": ["sheet", "defence", "skill"]
    },
    "Better": {
      "title": "Better",
      "description": "Which way an output's value improves the build: higher, lower, or neither way in itself.",
      "enum": ["higher", "lower", "neither"]
    },
    "OutputValue": {
      "title": "OutputValue",
      "description": "An output's value with its catalogue entry. The value is not rounded to places.",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "unit", "places", "group", "better", "order", "value"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "unit": { "$ref": "#/$defs/Unit" },
        "places": { "type": "integer", "minimum": 0 },
        "group": { "$ref": "#/$defs/OutputGroup" },
        "better": { "$ref": "#/$defs/Better" },
        "order": { "type": "integer", "minimum": 0 },
        "value": { "type": "number" }
      }
    },
    "Warning": {
      "title": "Warning",
      "description": "Something a run went on without; message says what was done about it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "subject", "message"],
      "properties": {
        "code": { "type": "string", "description": "The kind of warning, such as \"node-unknown\"." },
        "subject": { "type": "string", "description": "What it is about, such as \"node 12345\"; for reading, not matching." },
        "message": { "type": "string" },
        "slot": { "$ref": "#/$defs/Slot", "description": "The slot of the equipped item it is about; absent for others." },
        "stat": { "type": "string", "description": "The game stat id it is about; absent for others." }
      }
    },
    "Stats": {
      "title": "Stats",
      "description": "The result of one simulation: output values in display order or as asked for, and warnings.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "outputs", "warnings", "skill"],
      "properties": {
        "version": { "type": "string", "description": "The dataset version simulated on." },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/OutputValue" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/Warning" } },
        "skill": {
          "oneOf": [
            { "$ref": "#/$defs/MainSkill" },
            { "type": "null" }
          ],
          "description": "The main skill the skill outputs are read in; null when the build has none, and then it has no skill outputs."
        }
      }
    },
    "MainSkill": {
      "title": "MainSkill",
      "description": "The main skill as simulated: its gem, granted effect, level and quality with what items and supports add, and its skill types with those its supports add.",
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "gem", "id", "grantedEffect", "level", "quality", "types"],
      "properties": {
        "group": { "type": "integer", "description": "The skill group, from 0." },
        "gem": { "type": "integer", "description": "The gem in the group, from 0." },
        "id": { "type": "string", "description": "The gem's id." },
        "grantedEffect": { "type": "string" },
        "level": { "type": "integer" },
        "quality": { "type": "integer" },
        "types": { "type": "array", "items": { "type": "string" }, "description": "ActiveSkillType ids." }
      }
    },
    "GemRef": {
      "title": "GemRef",
      "description": "A gem in a skill group, by position and id.",
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "gem", "id"],
      "properties": {
        "group": { "type": "integer", "description": "The skill group, from 0." },
        "gem": { "type": "integer", "description": "The gem in the group, from 0." },
        "id": { "type": "string", "description": "The gem's id." }
      }
    },
    "Change": {
      "title": "Change",
      "description": "One output before and after.",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "unit", "places", "group", "better", "order", "before", "after", "abs", "pct", "changed"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "unit": { "$ref": "#/$defs/Unit" },
        "places": { "type": "integer", "minimum": 0 },
        "group": { "$ref": "#/$defs/OutputGroup" },
        "better": { "$ref": "#/$defs/Better" },
        "order": { "type": "integer", "minimum": 0 },
        "before": { "type": "number" },
        "after": { "type": "number" },
        "abs": { "type": "number", "description": "after - before." },
        "pct": {
          "type": ["number", "null"],
          "description": "abs as a percentage of |before|; null when before is 0."
        },
        "changed": { "type": "boolean", "description": "Whether before and after differ." }
      }
    },
    "StatValue": {
      "title": "StatValue",
      "description": "A game stat id with its value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["stat", "value"],
      "properties": {
        "stat": { "type": "string" },
        "value": { "type": "integer" }
      }
    },
    "NodeChange": {
      "title": "NodeChange",
      "description": "An allocated node whose data differs between two datasets.",
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "fields", "before", "after"],
      "properties": {
        "node": { "type": "integer", "minimum": 0 },
        "fields": { "type": "array", "items": { "type": "string" }, "description": "The node fields that differ." },
        "before": { "type": "array", "items": { "$ref": "#/$defs/StatValue" }, "description": "The node's stats, by stat id." },
        "after": { "type": "array", "items": { "$ref": "#/$defs/StatValue" } }
      }
    },
    "Diff": {
      "title": "Diff",
      "description": "Two simulations compared.",
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "changes", "edits", "dataChanges"],
      "properties": {
        "before": { "$ref": "#/$defs/Stats" },
        "after": { "$ref": "#/$defs/Stats" },
        "changes": {
          "type": "array",
          "items": { "$ref": "#/$defs/Change" },
          "description": "Each output computed on both sides, in the before side's order."
        },
        "edits": {
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/Edit" },
          "description": "Edits that turn the before build into the after build; null when none can (another game or tree variant)."
        },
        "dataChanges": {
          "type": "array",
          "items": { "$ref": "#/$defs/NodeChange" },
          "description": "Nodes either build allocates whose data differs between the two datasets, by node id."
        }
      }
    },
    "Result": {
      "title": "Result",
      "description": "One variant of a sweep.",
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "edits", "changes", "warnings", "error"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "description": "The variant's index in the sweep's variants." },
        "edits": { "type": "array", "items": { "$ref": "#/$defs/Edit" } },
        "changes": {
          "type": "array",
          "items": { "$ref": "#/$defs/Change" },
          "description": "Each output against the base build, in catalogue order; empty when error is set."
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/Warning" },
          "description": "Warnings about the variant's edits."
        },
        "error": { "type": ["string", "null"], "description": "Why the variant could not be simulated." }
      },
      "if": { "properties": { "error": { "type": "string" } } },
      "then": { "properties": { "changes": { "maxItems": 0 } } }
    },
    "Edit": {
      "title": "Edit",
      "description": "One change to a build. Fields other than op are present only when set.",
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": { "$ref": "#/$defs/EditOp" },
        "nodes": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "node": { "type": "integer", "minimum": 0, "description": "A node id; for socket-jewel and unsocket-jewel, a jewel socket's." },
        "effect": { "type": "integer", "minimum": 0 },
        "override": { "type": "string", "description": "A tattoo or runegraft of the tree, such as \"Tasalio3\"." },
        "level": { "type": "integer" },
        "class": { "type": "string" },
        "ascendancy": { "type": "string" },
        "bloodline": { "type": "string", "description": "An alternate ascendancy of the tree, such as \"Oshabi\"." },
        "key": { "type": "string", "description": "A config key." },
        "value": { "$ref": "#/$defs/ConfigValue" },
        "skill": { "$ref": "#/$defs/SkillAt" },
        "group": { "$ref": "#/$defs/SkillGroup" },
        "gem": { "$ref": "#/$defs/Gem" },
        "slot": { "$ref": "#/$defs/Slot" },
        "quality": { "type": "integer" },
        "enabled": { "type": "boolean" },
        "item": { "$ref": "#/$defs/Item" }
      }
    },
    "EditOp": {
      "title": "EditOp",
      "description": "What an edit changes.",
      "enum": [
        "allocate", "deallocate", "set-mastery", "clear-mastery", "set-override", "clear-override", "set-level", "set-class",
        "set-ascendancy", "set-bloodline", "set-config", "clear-config", "add-skill-group",
        "remove-skill-group", "set-skill-slot", "set-main-skill", "add-gem", "remove-gem",
        "set-active-gem", "set-gem-level", "set-gem-quality", "set-gem-enabled", "equip", "unequip",
        "socket-jewel", "unsocket-jewel"
      ]
    },
    "ConfigValue": {
      "title": "ConfigValue",
      "description": "A config value, as its key takes it.",
      "type": ["string", "number", "boolean"]
    },
    "Rarity": {
      "title": "Rarity",
      "enum": ["normal", "magic", "rare", "unique"]
    },
    "ModKind": {
      "title": "ModKind",
      "description": "Where on an item a mod line is.",
      "enum": ["implicit", "explicit", "enchant", "crafted", "fractured"]
    },
    "SkillAt": {
      "title": "SkillAt",
      "description": "A skill group, and a gem in it, by index; skill is which of the gem's skills, for set-active-gem.",
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "gem"],
      "properties": {
        "group": { "type": "integer" },
        "gem": { "type": "integer" },
        "skill": { "type": "integer" }
      }
    },
    "Slot": {
      "title": "Slot",
      "enum": [
        "weapon", "offhand", "weapon-swap", "offhand-swap", "helmet", "body-armour", "gloves", "boots",
        "amulet", "ring-1", "ring-2", "ring-3", "belt"
      ]
    },
    "SkillGroup": {
      "title": "SkillGroup",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slot": { "$ref": "#/$defs/Slot" },
        "gems": { "type": "array", "items": { "$ref": "#/$defs/Gem" } },
        "active": { "type": "integer", "minimum": 0 },
        "activeSkill": {
          "description": "Which skill of the active gem is the main one: 0 its first, 1 its second.",
          "type": "integer", "minimum": 0
        }
      }
    },
    "Gem": {
      "title": "Gem",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level"],
      "properties": {
        "id": { "type": "string", "description": "The dataset gem id." },
        "effect": { "type": "string", "description": "The variant's effect id, when not the gem's first." },
        "level": { "type": "integer" },
        "quality": { "type": "integer" },
        "support": { "type": "boolean" },
        "disabled": { "type": "boolean" }
      }
    },
    "Item": {
      "title": "Item",
      "type": "object",
      "additionalProperties": false,
      "required": ["rarity", "base"],
      "properties": {
        "rarity": { "$ref": "#/$defs/Rarity" },
        "name": { "type": "string" },
        "base": { "type": "string", "description": "The dataset item base id." },
        "itemLevel": { "type": "integer" },
        "quality": { "type": "integer" },
        "sockets": { "type": "string" },
        "armour": { "type": "integer" },
        "evasion": { "type": "integer" },
        "energyShield": { "type": "integer" },
        "ward": { "type": "integer" },
        "flags": { "type": "array", "items": { "type": "string" } },
        "mods": { "type": "array", "items": { "$ref": "#/$defs/ModLine" } }
      }
    },
    "ModLine": {
      "title": "ModLine",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": { "$ref": "#/$defs/ModKind" },
        "text": { "type": "string" },
        "mod": { "type": "string" },
        "stats": { "type": "array", "items": { "$ref": "#/$defs/StatValue" } }
      }
    },
    "Explanation": {
      "title": "Explanation",
      "description": "An output explained in one view.",
      "type": "object",
      "additionalProperties": false,
      "required": ["output", "view", "version", "amount", "effective", "value", "capBy", "lines", "tree", "skill", "damage"],
      "properties": {
        "output": { "$ref": "#/$defs/Output" },
        "view": { "$ref": "#/$defs/View" },
        "version": {
          "type": "string",
          "description": "The dataset version."
        },
        "amount": {
          "type": "number",
          "description": "The total before caps."
        },
        "effective": {
          "type": "number",
          "description": "The value after caps."
        },
        "value": {
          "type": "number",
          "description": "The value after rounding, as the sheet shows it."
        },
        "capBy": {
          "type": "array",
          "items": { "type": "string" },
          "description": "The engine stats whose values capped amount."
        },
        "lines": {
          "type": "array",
          "items": { "$ref": "#/$defs/Line" },
          "description": "The sources, for the proportional and marginal views; empty for the tree view."
        },
        "tree": {
          "oneOf": [
            { "$ref": "#/$defs/TreeNode" },
            { "type": "null" }
          ],
          "description": "The root of the tree view; null for the other views."
        },
        "skill": {
          "oneOf": [
            { "$ref": "#/$defs/GemRef" },
            { "type": "null" }
          ],
          "description": "The skill whose context a skill output is read in; null for other outputs."
        },
        "damage": {
          "type": "array",
          "items": { "enum": ["physical", "fire", "cold", "lightning", "chaos"] },
          "description": "The damage types of the part of the skill's damage read; empty for other outputs."
        }
      }
    },
    "View": {
      "title": "View",
      "description": "How an explanation attributes an output: how it is built (tree), each source's share (proportional) or what it loses without each source (marginal).",
      "enum": ["tree", "proportional", "marginal"]
    },
    "Op": {
      "title": "Op",
      "description": "How a modifier applies.",
      "enum": ["base", "inc", "more", "override", "flag"]
    },
    "Line": {
      "title": "Line",
      "description": "One source's share (proportional) or loss (marginal).",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "value", "total", "parts"],
      "properties": {
        "source": { "$ref": "#/$defs/Source" },
        "value": {
          "type": "number",
          "description": "The share of amount, or for the marginal view what the output's value loses."
        },
        "total": {
          "type": "number",
          "description": "For the marginal view, what amount loses; 0 otherwise."
        },
        "parts": {
          "type": "array",
          "items": { "$ref": "#/$defs/LinePart" },
          "description": "A proportional share by op and path."
        }
      }
    },
    "LinePart": {
      "title": "LinePart",
      "description": "Part of a share: from one op, through one path of engine stats.",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "value", "via", "from"],
      "properties": {
        "op": { "$ref": "#/$defs/Op" },
        "value": { "type": "number" },
        "via": {
          "type": "array",
          "items": { "type": "string" },
          "description": "The engine stats the share passed through, nearest first."
        },
        "from": {
          "oneOf": [
            { "$ref": "#/$defs/Source" },
            { "type": "null" }
          ],
          "description": "The source of the modifier when it is not the line's source."
        }
      }
    },
    "TreeNode": {
      "title": "TreeNode",
      "description": "One engine stat of a tree explanation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["stat", "formula", "terms", "overridden", "total", "capped", "value", "reads", "repeat"],
      "properties": {
        "stat": { "type": "string" },
        "formula": { "type": "string" },
        "terms": {
          "type": "array",
          "items": { "$ref": "#/$defs/TreeTerm" }
        },
        "overridden": { "type": "boolean" },
        "total": { "type": "number" },
        "capped": { "type": "number" },
        "value": { "type": "number" },
        "reads": {
          "type": "array",
          "items": { "$ref": "#/$defs/TreeNode" },
          "description": "The stats this one reads."
        },
        "repeat": {
          "type": "boolean",
          "description": "Shown higher up already; terms and reads are left out."
        }
      }
    },
    "TreeTerm": {
      "title": "TreeTerm",
      "description": "One modifier considered for a tree node.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "op", "value", "stat", "rate", "held"],
      "properties": {
        "source": { "$ref": "#/$defs/Source" },
        "op": { "$ref": "#/$defs/Op" },
        "value": { "type": "number" },
        "stat": {
          "type": "string",
          "description": "The engine stat the modifier is on when not the node's own; else empty."
        },
        "rate": {
          "type": "number",
          "description": "The share rate of a shared stat's modifier, else 1."
        },
        "held": {
          "type": "boolean",
          "description": "False when the modifier's condition failed."
        }
      }
    },
    "Source": {
      "title": "Source",
      "description": "What a value is credited to; kind says which fields it has.",
      "oneOf": [
        {
          "description": "A class's base stats.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "character" },
            "id": {
              "type": "string",
              "description": "The dataset character id."
            }
          }
        },
        {
          "description": "The character level.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "level" }
          }
        },
        {
          "description": "A passive node, or one of a mastery's effects.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "node", "effect"],
          "properties": {
            "kind": { "const": "node" },
            "node": {
              "type": "integer",
              "minimum": 0
            },
            "effect": {
              "type": "integer",
              "minimum": 0,
              "description": "The mastery effect id; 0 for the node's own stats."
            }
          }
        },
        {
          "description": "A quest reward.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "quest", "flag"],
          "properties": {
            "kind": { "const": "quest" },
            "quest": {
              "type": "string",
              "description": "The quest id; empty for a reward no quest owns."
            },
            "flag": {
              "type": "string",
              "description": "The quest flag that grants the reward."
            }
          }
        },
        {
          "description": "An equipped item.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "slot", "name"],
          "properties": {
            "kind": { "const": "item" },
            "slot": { "$ref": "#/$defs/Slot" },
            "name": {
              "type": "string",
              "description": "A rare or unique item's name, or a magic item's full name; empty for others."
            }
          }
        },
        {
          "description": "A jewel in a tree socket.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "node", "name"],
          "properties": {
            "kind": { "const": "jewel" },
            "node": {
              "type": "integer",
              "minimum": 0,
              "description": "The jewel socket node."
            },
            "name": {
              "type": "string",
              "description": "As an item's."
            }
          }
        },
        {
          "description": "A skill's or support's own stats.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "group", "gem", "id"],
          "properties": {
            "kind": { "const": "gem" },
            "group": { "type": "integer", "description": "The skill group, from 0." },
            "gem": { "type": "integer", "description": "The gem in the group, from 0." },
            "id": { "type": "string", "description": "The gem's id." }
          }
        },
        {
          "description": "A rule's own source.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "text"],
          "properties": {
            "kind": { "const": "rule" },
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Names the rule's source stably, such as \"strength-bonus-life\"."
            },
            "text": {
              "type": "string",
              "description": "The source in English, such as an inherent attribute bonus with its constant."
            }
          }
        }
      ]
    }
  }
}
