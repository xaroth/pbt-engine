include "characters.fbs";

namespace fb;

file_identifier "PBTR";

enum NodeKind: ubyte {
  Normal,
  Notable,
  Keystone,
  Mastery,
  JewelSocket,
  ClassStart,
  AscendancyStart,
  Proxy,
}

// stats render with the passive aura description scope.
table Buff {
  stats: [StatValue] (required);
}

table MasteryEffect {
  id: uint32;
  stats: [StatValue] (required);
}

table Node {
  id: uint32;
  kind: NodeKind;
  // Ascendancy id, or empty.
  ascendancy: string;
  stats: [StatValue] (required);
  buffs: [Buff];
  skill_points: int32;
  mastery_effects: [MasteryEffect];
  // Undirected edges, sorted.
  neighbours: [uint32] (required);
  multiple_choice: bool;
  multiple_choice_option: bool;
  // PassiveSkills.GrantedEffectsPerLevel; absent on nodes that grant no skill.
  granted_skill: GrantedSkill;
}

enum OverrideKind: ubyte {
  Tattoo,
  Runegraft,
}

// The nodes an override may replace.
enum OverrideTarget: ubyte {
  SmallStrength,
  SmallDexterity,
  SmallIntelligence,
  // A small node of any one attribute.
  SmallAttribute,
  // A notable that grants +30 to the attribute.
  StrengthNotable,
  DexterityNotable,
  IntelligenceNotable,
  Keystone,
  Mastery,
  AscendancyNotable,
}

// A tattoo or runegraft: stats that take the place of an allocated node's own.
table NodeOverride {
  // PassiveSkillOverrides id, such as Tasalio3.
  id: string (required);
  kind: OverrideKind;
  stats: [StatValue] (required);
  // Art path, as layout node icons name it.
  icon: string (required);
  target: OverrideTarget;
  // Bounds on the replaced node's neighbour count; 0 is no bound.
  min_neighbours: int32;
  max_neighbours: int32;
  // Nodes it may not replace, sorted.
  excluded_nodes: [uint32];
}

table Ascendancy {
  id: string (required);
}

// A class's index in classes is its class id.
table Class {
  // Characters id of the class, such as Metadata/Characters/Str/Str.
  character: string (required);
  base_strength: int32;
  base_dexterity: int32;
  base_intelligence: int32;
  start_node: uint32;
  ascendancies: [Ascendancy] (required);
}

table Tree {
  variant: string (required);
  total_points: int32;
  ascendancy_points: int32;
  classes: [Class] (required);
  alternate_ascendancies: [Ascendancy] (required);
  // Sorted by id.
  nodes: [Node] (required);
  jewel_slots: [uint32] (required);
  // Stat ids the file uses, sorted, so the file does not depend on the stats group's order.
  stat_ids: [string] (required);
  // Sorted by id; absent in trees without overrides.
  overrides: [NodeOverride];
}

root_type Tree;
