include "characters.fbs";

namespace fb;

file_identifier "PBTR";

enum NodeKind: ubyte {
  Normal,
  Notable,
  Keystone,
  Mastery,
  JewelSocket,
  ClassStart,
  AscendancyStart,
  Proxy,
}

// stats render with the passive aura description scope.
table Buff {
  stats: [StatValue] (required);
}

table MasteryEffect {
  id: uint32;
  stats: [StatValue] (required);
}

table Node {
  id: uint32;
  kind: NodeKind;
  // Ascendancy id, or empty.
  ascendancy: string;
  stats: [StatValue] (required);
  buffs: [Buff];
  skill_points: int32;
  mastery_effects: [MasteryEffect];
  // Undirected edges, sorted.
  neighbours: [uint32] (required);
  multiple_choice: bool;
  multiple_choice_option: bool;
  // PassiveSkills.GrantedEffectsPerLevel; absent on nodes that grant no skill.
  granted_skill: GrantedSkill;
}

enum OverrideKind: ubyte {
  Tattoo,
  Runegraft,
}

// The nodes an override may replace.
enum OverrideTarget: ubyte {
  SmallStrength,
  SmallDexterity,
  SmallIntelligence,
  // A small node of any one attribute.
  SmallAttribute,
  // A notable that grants +30 to the attribute.
  StrengthNotable,
  DexterityNotable,
  IntelligenceNotable,
  Keystone,
  Mastery,
  AscendancyNotable,
}

// A tattoo or runegraft: stats that take the place of an allocated node's own.
table NodeOverride {
  // PassiveSkillOverrides id, such as Tasalio3.
  id: string (required);
  kind: OverrideKind;
  stats: [StatValue] (required);
  // Art path, as layout node icons name it.
  icon: string (required);
  target: OverrideTarget;
  // Bounds on the replaced node's neighbour count; 0 is no bound.
  min_neighbours: int32;
  max_neighbours: int32;
  // Nodes it may not replace, sorted.
  excluded_nodes: [uint32];
}

// A PassiveJewelRadii row: the radius of a jewel and the ring Thread of Hope uses.
table JewelRadius {
  // Such as Large.
  id: string (required);
  radius: int32;
  ring_inner: int32;
  ring_outer: int32;
}

enum ClusterSize: ubyte {
  Small,
  Medium,
  Large,
}

// A jewel socket that takes a cluster jewel (PassiveJewelSlots).
table ClusterSocket {
  node: uint32;
  size: ClusterSize;
  // ClusterIndex: which of its parent's sockets it is.
  index: int32;
  // The proxy node whose group places the generated nodes.
  proxy: uint32;
  // The socket of the jewel it sits on; 0 for the tree's own sockets.
  parent: uint32;
  // StartIndices.
  start_indices: [int32];
}

// A PassiveTreeExpansionJewels row: how a cluster jewel of one size lays out its nodes.
table ClusterJewel {
  size: ClusterSize;
  // BaseItemTypes id.
  base: string (required);
  min_nodes: int32;
  max_nodes: int32;
  small_indices: [int32];
  notable_indices: [int32];
  socket_indices: [int32];
  total_indices: int32;
}

// A PassiveTreeExpansionSkills row: a kind of small passive a cluster jewel of size can add.
table ClusterSkill {
  size: ClusterSize;
  // A tree node.
  passive: uint32;
  // A tree node, or 0.
  mastery: uint32;
  // The Tags id the jewel's enchant names it by.
  tag: string (required);
}

// A PassiveTreeExpansionSpecialSkills row: the notable or keystone a cluster jewel mod adds.
table ClusterNotable {
  // A tree node.
  passive: uint32;
  // Index into the tree's stat_ids: the stat on the jewel's mod.
  stat: uint32;
}

table Clusters {
  // Sorted by node.
  sockets: [ClusterSocket];
  // Table order.
  jewels: [ClusterJewel];
  skills: [ClusterSkill];
  notables: [ClusterNotable];
}

// The PassiveType of an alternate passive row: the kinds of passive it applies to.
enum TimelessKind: ubyte {
  None,
  SmallAttribute,
  SmallNormal,
  Notable,
  Keystone,
  JewelSocket,
}

// A stat and the range its value rolls in.
struct StatRange {
  // Index into the tree's stat_ids.
  stat: uint32;
  min: int32;
  max: int32;
}

// An AlternatePassiveSkills row: a passive that replaces one in a timeless jewel's radius.
table TimelessReplacement {
  // Game id; data only, as some ids do not match their stats.
  id: string (required);
  kinds: [TimelessKind];
  // Row order.
  stats: [StatRange];
  weight: uint32;
  // RandomMin and RandomMax.
  additions_min: int32;
  additions_max: int32;
  // Set on keystones.
  conqueror_index: uint32;
  conqueror_version: uint32;
}

// An AlternatePassiveAdditions row: stats a timeless jewel adds to a passive in its radius.
table TimelessAddition {
  // Game id; data only.
  id: string (required);
  kinds: [TimelessKind];
  // Row order.
  stats: [StatRange];
  weight: uint32;
}

// An AlternateTreeVersions row with its replacements and additions, in table order.
table TimelessVersion {
  // Such as Vaal.
  id: string (required);
  small_attribute_replaced: bool;
  small_normal_replaced: bool;
  small_attribute_additions_min: int32;
  small_attribute_additions_max: int32;
  small_normal_additions_min: int32;
  small_normal_additions_max: int32;
  notable_additions_min: int32;
  notable_additions_max: int32;
  // Percent.
  notable_replacement_chance: int32;
  replacements: [TimelessReplacement];
  additions: [TimelessAddition];
}

table Ascendancy {
  id: string (required);
}

// A class's index in classes is its class id.
table Class {
  // Characters id of the class, such as Metadata/Characters/Str/Str.
  character: string (required);
  base_strength: int32;
  base_dexterity: int32;
  base_intelligence: int32;
  start_node: uint32;
  ascendancies: [Ascendancy] (required);
}

table Tree {
  variant: string (required);
  total_points: int32;
  ascendancy_points: int32;
  classes: [Class] (required);
  alternate_ascendancies: [Ascendancy] (required);
  // Sorted by id.
  nodes: [Node] (required);
  jewel_slots: [uint32] (required);
  // Stat ids the file uses, sorted, so the file does not depend on the stats group's order.
  stat_ids: [string] (required);
  // Sorted by id; absent in trees without overrides.
  overrides: [NodeOverride];
  // Table order; absent in trees without them.
  jewel_radii: [JewelRadius];
  // Absent in trees without cluster jewels.
  clusters: Clusters;
  // Table order, so a version's index is its game row; absent in trees without them.
  timeless_versions: [TimelessVersion];
}

root_type Tree;
