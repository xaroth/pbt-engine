namespace fb;

file_identifier "PBCH";

// stat is an index into the file's stat_ids.
struct StatValue {
  stat: uint32;
  value: int32;
}

// A skill a mod or passive grants: a GrantedEffects id in the skills group and one of its
// levels.
table GrantedSkill {
  effect: string (required);
  level: int32;
}

table Character {
  id: string (required);
  base_strength: int32;
  base_dexterity: int32;
  base_intelligence: int32;
  base_max_life: int32;
  base_max_mana: int32;
  // Stats block of the character's .ot, merged over extends.
  stats: [StatValue] (required);
  // Characters.MinDamage and MaxDamage, physical; Characters.WeaponSpeed in milliseconds per
  // attack. Unarmed attacks use them.
  unarmed_min_damage: int32;
  unarmed_max_damage: int32;
  unarmed_attack_time: int32;
}

table Characters {
  characters: [Character] (required);
  // Stat ids the file uses, sorted, so the file does not depend on the stats group's order.
  stat_ids: [string] (required);
}

root_type Characters;
