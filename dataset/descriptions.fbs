namespace fb;

file_identifier "PBDS";

// min/max are inclusive; with not set, the limit excludes min.
struct Limit {
  min: int32;
  max: int32;
  not: bool;
}

table Handler {
  name: string (required);
  stat: uint8;
}

table Variant {
  limits: [Limit] (required);
  text: string (required);
  handlers: [Handler];
}

table Description {
  stats: [string] (required);
  variants: [Variant];
}

table Scope {
  name: string (required);
  parent: string;
  descriptions: [Description] (required);
}

table Descriptions {
  scopes: [Scope] (required);
}

root_type Descriptions;
